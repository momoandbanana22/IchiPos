<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IchiPos</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <!-- バージョン番号の正典。AppVersion.Current はこの値から実行時に導出される（#52）。
         リリース時はここだけを更新する。 -->
    <Version>2.4.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>..\icon\IchiPos.ico</ApplicationIcon>
    <!-- ダークモード対応(issue #109)でWPF標準のThemeModeを使用する。.NET 10時点でもMicrosoftが
         「将来のバージョンで変更・削除されうる」と明記する実験的API(04書 G-019第4節)。 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fluentテーマの既定のMicaバックドロップ(半透明背景)を無効化し、不透明なテーマ背景にする(issue #109)。
         Micaは背後のデスクトップ/ウィンドウが透けて配色が崩れて見える原因になるため、公式のアプリコンテキスト
         スイッチで無効化する。これによりウィンドウの見た目がDWM合成に依存しなくなり、描画も安定・検証可能になる。 -->
    <RuntimeHostConfigurationOption
        Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop"
        Value="True" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Drawing.Common は Windows Desktop 共有フレームワーク（UseWindowsForms/UseWPF）が
         提供するため、明示的な PackageReference は不要（NU1510, #65）。 -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\icon\IchiPos.ico">
      <Link>icon\IchiPos.ico</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF有効化によりImplicitUsingsの既定セットが変わり、System.IO/System.Net.Httpが
         暗黙includeされなくなったため、明示的に復元する。 -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
